    "@playwright/test": "^1.60.0",
    "@types/wordpress__components": "^23.0.12",
    "@woocommerce/qit-runtime": "^0.1.3",
    "@wordpress/babel-plugin-makepot": "^6.26.0",
    "@wordpress/scripts": "^30.25.0",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.0",
    "browser-sync": "^3.0.4",
    "cross-env": "^10.0.0",
    "css-loader": "^7.1.2",
